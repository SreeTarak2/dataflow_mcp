# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=dataflow
MONGO_TIMEOUT=5000
MONGO_POOL_SIZE=10
MONGO_MAX_IDLE_TIME=45000

# Production MongoDB (Cloud Deployment)
# MONGO_USE_TLS=true
# MONGO_CA_CERT_PATH=/path/to/ca.pem
# MONGO_ALLOW_INVALID_CERTS=false

# Logging
LOGS_DIR=./logs
LOG_LEVEL=INFO

