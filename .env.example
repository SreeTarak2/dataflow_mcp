# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=dataflow
COLLECTION_NAME=Contests
MONGO_TIMEOUT=5000
MONGO_POOL_SIZE=10
MONGO_MAX_IDLE_TIME=45000

# Production MongoDB (Cloud Deployment)
# MONGO_USE_TLS=true
# MONGO_CA_CERT_PATH=/path/to/ca.pem
# MONGO_ALLOW_INVALID_CERTS=false

# Logging
LOGS_DIR=./logs
LOG_LEVEL=INFO

# --- Raw Data Connection (separate cluster for scraped raw data) ---
RAW_MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/CHRawdata?appName=Cluster0
RAW_DB_NAME=CHRawdata
RAW_COLLECTION=rawdata
